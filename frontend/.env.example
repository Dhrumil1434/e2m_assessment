VITE_API_URL=http://localhost:3000/api/v1
VITE_APP_ENV=development
# Set true when ComfyUI is running locally for photorealistic Apply Material
VITE_AI_USE_COMFY=true

# When sharing via ngrok, set VITE_API_URL to the API tunnel:
# VITE_API_URL=https://<api-ngrok-host>/api/v1
# Then restart `pnpm dev`. See docs/TUNNELING.md
