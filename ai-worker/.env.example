AI_WORKER_STUB_MODE=false
AI_WORKER_USE_SAM=false
AI_WORKER_USE_SAM2=false
AI_WORKER_USE_COMFY=false
AI_WORKER_USE_LM_PROMPTS=false
AI_WORKER_PORT=8002

# Optional: SAM2 (install requirements-ml.txt first)
SAM2_CHECKPOINT=checkpoints/sam2_hiera_tiny.pt
SAM2_CONFIG=configs/sam2/sam2_hiera_t.yaml

# Optional: LM Studio prompt engine
LM_STUDIO_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=local-model

# Optional: ComfyUI SD 1.5 inpainting
COMFYUI_URL=http://localhost:8188
INPAINT_MAX_SIDE=768
