PORT=3000
NODE_ENV=development

# Local browser URLs (default). When sharing via ngrok (single tunnel -> Vite):
#   CORS_ORIGIN / FRONTEND_URL / API_PUBLIC_URL = https://<ngrok-host>
#   Frontend VITE_API_URL=/api/v1  (Vite proxies /api -> Nest :3000)
# See docs/TUNNELING.md and scripts/start-ngrok.ps1
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:3000

DATABASE_URL=postgresql://e2m:e2m@localhost:5432/e2m

REDIS_HOST=localhost
REDIS_PORT=6379

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_ORIGINALS=originals
MINIO_BUCKET_MASKS=masks
MINIO_BUCKET_TEXTURES=textures
MINIO_BUCKET_PREVIEWS=previews
MINIO_BUCKET_REPORTS=reports

# Keep ai-worker / ComfyUI / MinIO on localhost even when using ngrok
AI_WORKER_URL=http://localhost:8002
AI_WORKER_STUB_MODE=false
AI_WORKER_USE_COMFY=true

THROTTLE_TTL=60
THROTTLE_LIMIT=60
